{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "height": 28,
  "spacing": 5,
  "margin-top": 5,
  "margin-right": 10,
  "margin-left": 10,
  "include": "~/.config/waybar/modules.jsonc",
  "reload_style_on_change": true,
  "modules-left": [
    "custom/drop",
    "hyprland/window",
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "custom/audio_idle_inhibitor",
    "group/stats",
    "custom/weather",
    "clock",
    "custom/updates",
    "custom/memory",
    "custom/cpuinfo",
    "cpu",
    "custom/gpuinfo",
    "idle_inhibitor",
    "pulseaudio",
    "hyprland/language",
    "network",
    "tray",
    "custom/screen-record",
    "privacy",
    "group/system-controls"
  ],
}
