{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "height": 26,
  "spacing": 5,
  "margin-top": 5,
  "margin-right": 6,
  "margin-left": 6,
  "include": "~/.config/waybar/modules.jsonc",
  "reload_style_on_change": true,
  "modules-left": [
    "custom/drop",
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "custom/weather",
    "clock"
  ],
  "modules-right": [
    "group/stats",
    "custom/audio_idle_inhibitor",
    "custom/idle-inhibitor",
    "group/privacy-controls",
    "custom/updates",
    "custom/memory",
    "custom/cpuinfo",
    "cpu",
    "custom/gpuinfo",
    "pulseaudio",
    "hyprland/language",
    "network",
    "tray",
    "group/system-controls",
  ],
}
