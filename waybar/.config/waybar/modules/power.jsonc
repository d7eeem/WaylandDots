{
  "group/system-controls": {
    "orientation": "horizontal",
    "modules": [
      "custom/notification",
      "custom/power"
    ]
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "menu": "on-click-right",
    "menu-file": "$HOME/.config/waybar/menus/power_menu.xml",
    "menu-actions": {
      "suspend": "systemctl suspend",
      "logout": "hyprctl dispatch exit",
      "shutdown": "systemctl poweroff",
      "reboot": "systemctl reboot",
      "lock": "hyprlock"
    },
    "on-click": "uwsm app -- wlogout",
    "on-click-middle": "uwsm app -- ~/.config/rofi/powermenu/powermenu.sh"
  },
  "custom/notification": {
    "tooltip": false,
    "format": " {icon} ",
    "format-icons": {
      "notification": "",
      "none": "",
      "dnd-notification": "󰂠",
      "dnd-none": "󰂠",
      "inhibited-notification": "󱏧",
      "inhibited-none": "",
      "dnd-inhibited-notification": "",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-middle": "swaync-client -d -sw",
    "on-click-right": "swaync-client -cp",
    "escape": true
  }
}
