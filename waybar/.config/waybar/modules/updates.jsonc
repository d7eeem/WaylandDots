{
  "custom/updates": {
    "exec": "$HOME/.local/bin/statusbar/systemupdate.fish",
    "return-type": "json",
    "format": "{}",
    "rotate": 0,
    "on-click": "hyprctl dispatch exec '$HOME/.local/bin/statusbar/systemupdate.sh up'",
    "interval": 86400,
    "tooltip": true,
    "signal": 20
  }
}