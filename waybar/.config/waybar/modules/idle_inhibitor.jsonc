{
  "custom/idle-inhibitor": {
    "format": "{}",
    "return-type": "json",
    "interval": 10,
    "exec": "~/.config/waybar/scripts/idle-inhibitor.sh status",
    "on-click": "~/.config/waybar/scripts/idle-inhibitor.sh toggle && pkill -RTMIN+8 waybar",
    "on-click-right": "~/.config/waybar/scripts/idle-inhibitor-menu.sh",
    "signal": 8,
  },
