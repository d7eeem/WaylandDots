{
  "group/win": {
    "orientation": "vertical",
    "modules": [
      "hyprland/window",
      "hyprland/window#win2"
    ]
  },
  "hyprland/window": {
    "format": "{title}",
    "rewrite": {
      "title<.*youtube.*>": "\uf16a",
      "(.*) — Zen Browser": " $1",
      "(.*) — Mozilla Firefox": " $1",
      "Steam": " Steam 󰓓 ",
      "Discord": "Discord  ",
      "KiTTY": "KITTY 󰄛"
    },
    "max-length": 24,
    "on-click-middle": "hyprctl dispatch killactive"
  },
  "hyprland/window#win2": {
    "format": "{title}",
    "on-click-middle": "hyprctl dispatch killactive"
  }
}
