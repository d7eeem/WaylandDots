{
  "hyprland/window": {
    "format": "{title}",
    "rotate": 0,
    "separate-outputs": true,
    "rewrite": {
      "title<.*youtube.*>": "\uf16a",
      "(.*) — zen browser": "zen browser - $1",
      "(.*) — mozilla firefox": " $1",
      "steam": " steam 󰓓 ",
      "discord": "discord  ",
      "kitty": "kitty 󰄛",
      "class<com\\.mitchellh\\.ghostty>": "ghostty - $1",
      "title<(.*)> class<com\\.mitchellh\\.ghostty>": "ghostty - $1",
    },
    "max-length": 36,
  },
}
