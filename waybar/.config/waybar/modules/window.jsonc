{
  "hyprland/window": {
    "format": "{title}",
    "rotate": 0,
    "separate-outputs": true,
    "rewrite": {
      "title<.*youtube.*>": "\uf16a",
      "(.*) — Zen Browser": "Zen Browser - $1",
      "(.*) — Mozilla Firefox": " $1",
      "Steam": " Steam 󰓓 ",
      "Discord": "Discord  ",
      "KiTTY": "KITTY 󰄛"
    },
    "max-length": 36
  }
}
