* {
  /* Material Design 3 Color Palette from Matugen */
  
  /* Primary colors */
  primary: #ffb3ad;
  primary-fixed: #ffdad7;
  primary-fixed-dim: #ffb3ad;
  on-primary: #571e1b;
  on-primary-fixed: #3b0908;
  on-primary-fixed-variant: #73332f;
  primary-container: #73332f;
  on-primary-container: #ffdad7;
  
  /* Secondary colors */
  secondary: #e7bdb9;
  secondary-fixed: #ffdad7;
  secondary-fixed-dim: #e7bdb9;
  on-secondary: #442927;
  on-secondary-fixed: #2c1513;
  on-secondary-fixed-variant: #5d3f3d;
  secondary-container: #5d3f3d;
  on-secondary-container: #ffdad7;
  
  /* Tertiary colors */
  tertiary: #e1c28c;
  tertiary-fixed: #ffdea6;
  tertiary-fixed-dim: #e1c28c;
  on-tertiary: #402d04;
  on-tertiary-fixed: #261900;
  on-tertiary-fixed-variant: #584319;
  tertiary-container: #584319;
  on-tertiary-container: #ffdea6;
  
  /* Error colors */
  error: #ffb4ab;
  on-error: #690005;
  error-container: #93000a;
  on-error-container: #ffdad6;
  
  /* Surface colors */
  surface: #1a1110;
  on-surface: #f1dedd;
  on-surface-variant: #d8c2bf;
  outline: #a08c8a;
  outline-variant: #534342;
  shadow: #000000;
  scrim: #000000;
  inverse-surface: #f1dedd;
  inverse-on-surface: #392e2d;
  inverse-primary: #904a45;
  surface-dim: #1a1110;
  surface-bright: #423736;
  surface-container-lowest: #140c0b;
  surface-container-low: #231918;
  surface-container: #271d1c;
  surface-container-high: #322827;
  surface-container-highest: #3d3231;

  /* Mapped Rofi color variables */
  background: @surface;
  foreground: @on-surface;
  border-color: @outline-variant;
  
  active-background: @primary;
  active-foreground: @on-primary;
  
  normal-background: @surface;
  normal-foreground: @on-surface;
  
  urgent-background: @error;
  urgent-foreground: @on-error;
  
  alternate-active-background: @surface-container;
  alternate-active-foreground: @on-surface;
  alternate-normal-background: @surface;
  alternate-normal-foreground: @on-surface;
  alternate-urgent-background: @surface;
  alternate-urgent-foreground: @on-surface;
  
  selected-active-background: @primary;
  selected-active-foreground: @on-primary;
  selected-normal-background: @primary-container;
  selected-normal-foreground: @on-primary-container;
  selected-urgent-background: @error-container;
  selected-urgent-foreground: @on-error-container;
  
  background-color: @background;
  spacing: 2;
}

#window {
    background-color: @background;
    border: 0;
    padding: 2.5ch;
}

#mainbox {
    border: 0;
    padding: 0;
}

#message {
    border: 2px 0px 0px;
    border-color: @border-color;
    padding: 1px;
}

#textbox {
    text-color: @foreground;
}

#inputbar {
    children: [ prompt, textbox-prompt-colon, entry, case-indicator ];
}

#textbox-prompt-colon {
    expand: false;
    str: ":";
    margin: 0px 0.3em 0em 0em;
    text-color: @normal-foreground;
}

#listview {
    fixed-height: 0;
    border-color: @border-color;
    spacing: 2px;
    scrollbar: true;
    padding: 2px 0px 0px;
}

#element {
    border: 0;
    padding: 1px;
}

#element-text, element-icon {
    background-color: inherit;
    text-color: inherit;
}

#element.normal.normal {
    background-color: @normal-background;
    text-color: @normal-foreground;
}

#element.normal.urgent {
    background-color: @urgent-background;
    text-color: @urgent-foreground;
}

#element.normal.active {
    background-color: @active-background;
    text-color: @active-foreground;
}

#element.selected.normal {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
}

#element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color: @selected-urgent-foreground;
}

#element.selected.active {
    background-color: @selected-active-background;
    text-color: @selected-active-foreground;
}

#element.alternate.normal {
    background-color: @alternate-normal-background;
    text-color: @alternate-normal-foreground;
}

#element.alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color: @alternate-urgent-foreground;
}

#element.alternate.active {
    background-color: @alternate-active-background;
    text-color: @alternate-active-foreground;
}

#scrollbar {
    width: 4px;
    border: 0;
    handle-width: 8px;
    padding: 0;
}

#sidebar {
    border: 2px 0px 0px;
    border-color: @border-color;
}

#button {
    text-color: @normal-foreground;
}

#button.selected {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
}

#inputbar {
    spacing: 0;
    text-color: @normal-foreground;
    padding: 1px;
}

#case-indicator {
    spacing: 0;
    text-color: @normal-foreground;
}

#entry {
    spacing: 0;
    text-color: @normal-foreground;
}

#prompt {
    spacing: 0;
    text-color: @normal-foreground;
}
