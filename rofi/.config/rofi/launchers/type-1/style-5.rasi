configuration {
  modi: "drun,run";
  display-drun: "Applications";
  display-window: "Windows";
  display-run: "Run";
  drun-display-format: "{icon} {name}";
  font: "0xProto Nerd Font Propo 10";
  show-icons: true;
  icon-theme: "MacTahoe-dark";
}

* {
    bg: #181f21;
    primary: #8ccf7e;
    secondbg: #1a2224;
    alt: #1a2224;
    text-color: #d6e3e0;
    rad: 12px;
    background-color: @bg;
    text-color: #d6e3e0;
}

window {
  transparency: "real";
  location: center;
  anchor: center;
  fullscreen: false;
  width: 750px;
  height: 400px;
  x-offset: 0px;
  y-offset: 0px;
  enabled: true;
  border: 2px solid;
  border-color: @bg;
  border-radius: 7px;
  cursor: "default";
  background-color: @bg;
}

mainbox {
  enabled: true;
  spacing: 0px;
  background-color: transparent;
  orientation: horizontal;
  children: [ "imagebox", "listbox" ];
}

imagebox {
  padding: 20px;
  background-color: transparent;
  background-image: url("~/.cache/wallpaper/wall-rofi.sqre", height);
  background-image-position: center;
  orientation: vertical;
  border-radius: 7px;
  children: [ "inputbar", "dummy", "mode-switcher" ];
}

listbox {
  spacing: 20px;
  padding: 20px;
  background-color: transparent;
  orientation: vertical;
  children: [ "message", "listview" ];
}

dummy {
  background-color: transparent;
}

inputbar {
  enabled: true;
  spacing: 10px;
  padding: 10px;
  border-radius: 7px;
  background-color: @bg;
  text-color: #d6e3e0;
  children: [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
  enabled: true;
  expand: false;
  padding: 5px;
  border-radius: 7px;
  str: "  ";
  background-color: @bg;
  text-color: @primary;
}

#entry {
  spacing: 4px;
  padding: 4px;
  border-radius: 7px;
  background-color: @secondbg;
  text-color: #d6e3e0;
}

mode-switcher {
  enabled: true;
  spacing: 20px;
  background-color: transparent;
  text-color: #d6e3e0;
}

button {
  padding: 15px;
  border-radius: 7px;
  background-color: @bg;
  text-color: #d6e3e0;
  cursor: pointer;
}

button selected {
  background-color: @primary;
  text-color: @bg;
}

listview {
  enabled: true;
  columns: 1;
  lines: 6;
  cycle: true;
  dynamic: true;
  scrollbar: false;
  layout: vertical;
  reverse: false;
  fixed-height: true;
  fixed-columns: true;
  spacing: 10px;
  background-color: transparent;
  text-color: #d6e3e0;
  cursor: "default";
}

element {
  enabled: true;
  spacing: 15px;
  padding: 8px;
  border-radius: 7px;
  background-color: transparent;
  text-color: #d6e3e0;
  cursor: pointer;
}

element normal.normal {
  background-color: transparent;
  text-color: #d6e3e0;
}

element normal.active {
  background-color: @secondbg;
  text-color: #d6e3e0;
}

element normal.urgent {
  background-color: @alt;
  text-color: #d6e3e0;
}

element selected.normal {
  background-color: @primary;
  text-color: @bg;
}

element selected.urgent {
  background-color: @primary;
  text-color: @bg;
}

element selected.active {
  background-color: @primary;
  text-color: @bg;
}

element-icon {
  background-color: transparent;
  text-color: inherit;
  size: 32px;
  cursor: inherit;
}

element-text {
  background-color: transparent;
  text-color: inherit;
  cursor: inherit;
  vertical-align: 0.5;
  horizontal-align: 0.0;
}

message {
  background-color: transparent;
}

textbox {
  padding: 15px;
  border-radius: 7px;
  background-color: @bg;
  text-color: #d6e3e0;
  vertical-align: 0.5;
  horizontal-align: 0.0;
}

error-message {
  padding: 15px;
  border-radius: 20px;
  background-color: @bg;
  text-color: @primary;
}

