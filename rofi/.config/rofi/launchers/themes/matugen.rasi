* {
  /* Material Design 3 Color Palette from Matugen */
  
  /* Primary colors */
  primary: #96cdf8;
  primary-fixed: #cae6ff;
  primary-fixed-dim: #96cdf8;
  on-primary: #00344f;
  on-primary-fixed: #001e30;
  on-primary-fixed-variant: #004b70;
  primary-container: #004b70;
  on-primary-container: #cae6ff;
  
  /* Secondary colors */
  secondary: #b7c9d9;
  secondary-fixed: #d3e5f6;
  secondary-fixed-dim: #b7c9d9;
  on-secondary: #22323f;
  on-secondary-fixed: #0c1d29;
  on-secondary-fixed-variant: #384956;
  secondary-container: #384956;
  on-secondary-container: #d3e5f6;
  
  /* Tertiary colors */
  tertiary: #cfc0e8;
  tertiary-fixed: #ebdcff;
  tertiary-fixed-dim: #cfc0e8;
  on-tertiary: #362b4a;
  on-tertiary-fixed: #201634;
  on-tertiary-fixed-variant: #4d4162;
  tertiary-container: #4d4162;
  on-tertiary-container: #ebdcff;
  
  /* Error colors */
  error: #ffb4ab;
  on-error: #690005;
  error-container: #93000a;
  on-error-container: #ffdad6;
  
  /* Surface colors */
  surface: #101417;
  on-surface: #e0e3e8;
  on-surface-variant: #c1c7ce;
  outline: #8b9198;
  outline-variant: #41474d;
  shadow: #000000;
  scrim: #000000;
  inverse-surface: #e0e3e8;
  inverse-on-surface: #2d3135;
  inverse-primary: #28638a;
  surface-dim: #101417;
  surface-bright: #363a3e;
  surface-container-lowest: #0b0f12;
  surface-container-low: #181c20;
  surface-container: #1c2024;
  surface-container-high: #262a2e;
  surface-container-highest: #313539;

  /* Mapped Rofi color variables */
  background: @surface;
  foreground: @on-surface;
  border-color: @outline-variant;
  
  active-background: @primary;
  active-foreground: @on-primary;
  
  normal-background: @surface;
  normal-foreground: @on-surface;
  
  urgent-background: @error;
  urgent-foreground: @on-error;
  
  alternate-active-background: @surface-container;
  alternate-active-foreground: @on-surface;
  alternate-normal-background: @surface;
  alternate-normal-foreground: @on-surface;
  alternate-urgent-background: @surface;
  alternate-urgent-foreground: @on-surface;
  
  selected-active-background: @primary;
  selected-active-foreground: @on-primary;
  selected-normal-background: @primary-container;
  selected-normal-foreground: @on-primary-container;
  selected-urgent-background: @error-container;
  selected-urgent-foreground: @on-error-container;
  
  background-color: @background;
  spacing: 2;
}
