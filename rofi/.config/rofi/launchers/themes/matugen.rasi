* {
  /* Material Design 3 Color Palette from Matugen */
  
  /* Primary colors */
  primary: #e9b5ef;
  primary-fixed: #fdd6ff;
  primary-fixed-dim: #e9b5ef;
  on-primary: #472150;
  on-primary-fixed: #300a39;
  on-primary-fixed-variant: #603768;
  primary-container: #603768;
  on-primary-container: #fdd6ff;
  
  /* Secondary colors */
  secondary: #d6c0d6;
  secondary-fixed: #f3dbf2;
  secondary-fixed-dim: #d6c0d6;
  on-secondary: #3b2b3c;
  on-secondary-fixed: #241727;
  on-secondary-fixed-variant: #524153;
  secondary-container: #524153;
  on-secondary-container: #f3dbf2;
  
  /* Tertiary colors */
  tertiary: #f5b7b0;
  tertiary-fixed: #ffdad5;
  tertiary-fixed-dim: #f5b7b0;
  on-tertiary: #4c2521;
  on-tertiary-fixed: #33110e;
  on-tertiary-fixed-variant: #673b36;
  tertiary-container: #673b36;
  on-tertiary-container: #ffdad5;
  
  /* Error colors */
  error: #ffb4ab;
  on-error: #690005;
  error-container: #93000a;
  on-error-container: #ffdad6;
  
  /* Surface colors */
  surface: #171217;
  on-surface: #eae0e7;
  on-surface-variant: #cfc3cd;
  outline: #988d97;
  outline-variant: #4d444c;
  shadow: #000000;
  scrim: #000000;
  inverse-surface: #eae0e7;
  inverse-on-surface: #342f34;
  inverse-primary: #7a4f81;
  surface-dim: #171217;
  surface-bright: #3d373d;
  surface-container-lowest: #110d11;
  surface-container-low: #1f1a1f;
  surface-container: #231e23;
  surface-container-high: #2e282e;
  surface-container-highest: #393338;

  /* Mapped Rofi color variables */
  background: @surface;
  foreground: @on-surface;
  border-color: @outline-variant;
  
  active-background: @primary;
  active-foreground: @on-primary;
  
  normal-background: @surface;
  normal-foreground: @on-surface;
  
  urgent-background: @error;
  urgent-foreground: @on-error;
  
  alternate-active-background: @surface-container;
  alternate-active-foreground: @on-surface;
  alternate-normal-background: @surface;
  alternate-normal-foreground: @on-surface;
  alternate-urgent-background: @surface;
  alternate-urgent-foreground: @on-surface;
  
  selected-active-background: @primary;
  selected-active-foreground: @on-primary;
  selected-normal-background: @primary-container;
  selected-normal-foreground: @on-primary-container;
  selected-urgent-background: @error-container;
  selected-urgent-foreground: @on-error-container;
  
  background-color: @background;
  spacing: 2;
}
