# Ghostty theme configuration for Matugen
# Place this in your Matugen templates directory
# Typically: ~/.config/matugen/templates/ghostty.conf

# Background and foreground - using proper dark surface colors
background = {{colors.surface.default.hex}}
foreground = {{colors.on_surface.default.hex}}

# Cursor
cursor-color = {{colors.primary.default.hex}}
cursor-text = {{colors.on_primary.default.hex}}

# Selection
selection-background = {{colors.primary_container.default.hex}}
selection-foreground = {{colors.on_primary_container.default.hex}}

# Black
palette = 0={{colors.surface_dim.default.hex}}
palette = 8={{colors.surface_bright.default.hex}}

# Red
palette = 1={{colors.error.default.hex}}
palette = 9={{colors.error.default.hex}}

# Green
palette = 2={{colors.tertiary.default.hex}}
palette = 10={{colors.tertiary.default.hex}}

# Yellow
palette = 3={{colors.secondary.default.hex}}
palette = 11={{colors.secondary.default.hex}}

# Blue
palette = 4={{colors.primary.default.hex}}
palette = 12={{colors.primary.default.hex}}

# Magenta
palette = 5={{colors.tertiary_container.default.hex}}
palette = 13={{colors.tertiary_container.default.hex}}

# Cyan
palette = 6={{colors.secondary_container.default.hex}}
palette = 14={{colors.secondary_container.default.hex}}

# White
palette = 7={{colors.on_surface_variant.default.hex}}
palette = 15={{colors.on_surface.default.hex}}

# Additional UI colors
background-opacity = 0.95
window-padding-x = 4
window-padding-y = 4
